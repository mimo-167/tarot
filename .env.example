# 仅服务端读取；不要使用 NEXT_PUBLIC_ 前缀
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：直连 DeepSeek，或替换为自己的 OpenAI-compatible 网关完整地址
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 邮箱验证码登录。生产环境请使用 Wrangler Secret，不要写进 wrangler.jsonc。
RESEND_API_KEY=your_resend_api_key
AUTH_SECRET=replace_with_at_least_32_random_bytes

# 非敏感配置；生产值以 wrangler.jsonc 为准。
ADMIN_EMAIL=your_admin_email@example.com
RESEND_FROM_EMAIL=Moon & Stars Tarot <login@mail.example.com>
