{
  "name": "xingyue-tarot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build --webpack",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "generate:data": "node scripts/generate-tarot-data.mjs",
    "cf:build": "npm run clean:build && opennextjs-cloudflare build --noMinify",
    "preview": "npm run clean:build && opennextjs-cloudflare build --noMinify && opennextjs-cloudflare preview",
    "deploy": "npm run clean:build && opennextjs-cloudflare build --noMinify && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "puppeteer-core": "25.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
